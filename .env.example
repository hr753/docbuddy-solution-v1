# Copy this file to .env and fill in real values. Never commit .env.

# Comma-separated list of accepted API keys (make your own random strings)
API_KEYS=change-me-key-1,change-me-key-2

# Comma-separated list of browser origins allowed to call the API (Streamlit runs on 8501)
CORS_ORIGINS=http://localhost:8501

# Which LLM to use. "fake" needs no key and is what we use in class.
LLM_PROVIDER=fake
